{
  "compilerOptions": {
    "strict": true,
    "module": "ES2022",
    "target": "ES2020",
    "lib": ["ES2023"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "skipLibCheck": true,
    "types": [],
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "@girs/**/*.d.ts"],
  "exclude": ["node_modules", "tools"]
}
