{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "tty-workspace-chrome"
          },
          "size": {
            "px": 36
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "tty-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "tty-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "tty-workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tty-tabs"
          },
          "size": {
            "px": 36
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "tty-pane"
                    },
                    "reveal": "always",
                    "height": 26,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 1,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "tty-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "tty-changes"
                      }
                    },
                    {
                      "id": "repo",
                      "type": "block",
                      "content": {
                        "mod": "tty-repo"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 0
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "tty-workspace-status"
          },
          "size": {
            "px": 24
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "font": "JetBrains Mono",
  "ui_font": "JetBrains Mono",
  "font_size": 14,
  "terminal_menu": "tty-menu",
  "toast": "tty-toast",
  "terminal_padding": [
    8,
    10
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
