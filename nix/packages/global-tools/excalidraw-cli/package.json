    "@oclif/plugin-help": "^2",
    "canvas": "^2.6.1",
    "chalk": "^4.0.0",
    "cpy-cli": "^3.1.1",
    "fs-extra": "^9.0.1",
    "fs-readdir-recursive": "^1.1.0",
    "listr": "^0.14.3",
    "listr2": "^2.1.9",
    "roughjs": "^4.3.1",
    "rxjs": "^6.5.5",
    "tslib": "2.8.1"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/tommywalkie/excalidraw-cli#readme",
