# Only portable configuration belongs in Git. Everything else stays local.
/*
!/.gitignore
!/README.md
!/settings.json
!/keys.json
!/programs.json
!/themes/
!/layouts/
!/mods/
!/backgrounds/
!/fonts/
!/my-icons/

# Herdr owns these shipped layouts and mods; clone them before editing.
/layouts/.state/
/layouts/main.json
/layouts/terminals.json
/layouts/win98.json
/layouts/win98.svg
/mods/agents/
/mods/changes/
/mods/confirm/
/mods/files/
/mods/help/
/mods/machine-add/
/mods/menu/
/mods/new-menu/
/mods/pane/
/mods/peek/
/mods/picker/
/mods/prompt/
/mods/spaces/
/mods/tabs/
/mods/terminals-bar/
/mods/terminals-pane/
/mods/toast/
/mods/win98/
/mods/workspace-chrome/
/mods/workspace-status/
/mods/worktree/
/themes/atom-one-dark.json
/themes/win98.json

# Generated mod metadata and local dependencies.
**/node_modules/
**/jsconfig.json
**/*.d.ts
**/*.error
**/*.reset-*
**/*.old-*
