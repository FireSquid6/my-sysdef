# Prefer Nix in non-interactive shells too; retain old installs as fallback.
if [ -d "$HOME/.nix-profile/bin" ]; then export PATH="$HOME/.nix-profile/bin:$PATH"; fi

[[ $- == *i* ]] || return

export PATH="$PATH:$SCRIPTS_DIR"

eval "$(direnv hook bash)"

alias e='NVIM_APPNAME=ink-nvim nvim'

# Added by flyctl installer
export FLYCTL_INSTALL="$HOME/.fly"
export PATH="$FLYCTL_INSTALL/bin:$PATH"

# Hermes Agent command
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# Keep Nix first even after local-tool setup above.
if [ -d "$HOME/.nix-profile/bin" ]; then export PATH="$HOME/.nix-profile/bin:$PATH"; fi
