{
  "name": "@tommywalkie/excalidraw-cli",
  "version": "0.5.0",
  "description": "Experimental Excalidraw CLI tool",
  "author": "Tom Bazarnik <tommywalkie@gmail.com>",
  "bin": {
    "excalidraw-cli": "./bin/run"
  },
